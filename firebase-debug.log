[debug] [2026-11-02T13:28:44.523Z] >>> [apiv2][body] PUT https://quickcheck-25590-default-rtdb.asia-southeast1.firebasedatabase.app/.settings/rules.json "{\n  \"rules\": {\n    \".read\": false,\n    \".write\": false,\n\n    \"tutor_course_stats\": {\n      \"$course\": {\n        \"students\": { \".read\": true },\n        \".write\": false\n      }\n    },\n    \"tutor_public_teachers\": {\n      \"$uid\": {\n        \".read\": true,\n        \".write\": false\n      }\n    },\n    \"tutor_roles\": {\n      \"$uid\": {\n        \".read\": true,\n        \".write\": \"auth != null && auth.uid === $uid && newData.exists()\",\n        \".validate\": \"newData.val() === 'student' || newData.val() === 'teacher'\"\n      }\n    },\n    \"tutor_profiles\": {\n      \"$uid\": {\n        \".read\": true,\n        \".write\": \"auth != null && auth.uid === $uid && root.child('tutor_roles').child(auth.uid).val() === 'teacher'\",\n        \".validate\": \"newData.hasChildren(['experience','qualification','about','imageURL','updatedAt'])\",\n        \"experience\": { \".validate\": \"newData.isNumber() && newData.val() >= 0 && newData.val() <= 80 && newData.val() % 1 === 0\" },\n        \"qualification\": { \".validate\": \"newData.isString() && newData.val().length <= 120\" },\n        \"about\": { \".validate\": \"newData.isString() && newData.val().length <= 3000\" },\n        \"imageURL\": { \".validate\": \"newData.isString() && newData.val().length <= 2000 && (newData.val() === '' || newData.val().beginsWith('https://'))\" },\n        \"updatedAt\": { \".validate\": \"newData.isNumber() && newData.val() === now\" },\n        \"$other\": { \".validate\": false }\n      }\n    },\n    \"tutor_courses\": {\n      \".read\": true,\n      \".indexOn\": [\"teacherId\", \"published\"],\n      \"$course\": {\n        \".write\": \"auth != null && root.child('tutor_roles').child(auth.uid).val() === 'teacher' && newData.exists() && newData.child('teacherId').val() === auth.uid && (!data.exists() || data.child('teacherId').val() === auth.uid)\",\n        \".validate\": \"newData.hasChildren(['teacherId','teacherName','title','summary','whatYouLearn','curriculum','schedule','category','type','price','originalPrice','coverURL','previewURL','previewPath','previewType','published','createdAt','updatedAt']) && (newData.child('archived').val() !== true || newData.child('published').val() === false)\",\n        \"teacherId\": { \".validate\": \"newData.isString() && (!data.exists() || newData.val() === data.val())\" },\n        \"teacherName\": { \".validate\": \"newData.isString() && newData.val().length > 0 && newData.val().length <= 100\" },\n        \"title\": { \".validate\": \"newData.isString() && newData.val().length > 0 && newData.val().length <= 120\" },\n        \"summary\": { \".validate\": \"newData.isString() && newData.val().length > 0 && newData.val().length <= 500\" },\n        \"whatYouLearn\": { \".validate\": \"newData.isString() && newData.val().length > 0 && newData.val().length <= 1200\" },\n        \"curriculum\": { \".validate\": \"newData.isString() && newData.val().length > 0 && newData.val().length <= 5000\" },\n        \"schedule\": { \".validate\": \"newData.isString() && newData.val().length > 0 && newData.val().length <= 300\" },\n        \"category\": { \".validate\": \"newData.val() === 'ielts' || newData.val() === 'speaking' || newData.val() === 'listening' || newData.val() === 'reading' || newData.val() === 'writing' || newData.val() === 'general' || newData.val() === 'business' || newData.val() === 'others'\" },\n        \"type\": { \".validate\": \"newData.val() === 'live' || newData.val() === 'self' || newData.val() === 'package'\" },\n        \"price\": { \".validate\": \"newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000 && newData.val() % 1 === 0\" },\n        \"originalPrice\": { \".validate\": \"newData.isNumber() && newData.val() % 1 === 0 && newData.val() <= 100000000 && (newData.val() === 0 || newData.val() > newData.parent().child('price').val())\" },\n        \"coverURL\": { \".validate\": \"newData.isString() && newData.val().length <= 2000 && (newData.val() === '' || newData.val().beginsWith('https://'))\" },\n        \"previewURL\": { \".validate\": \"newData.isString() && newData.val().length <= 2000 && (newData.val() === '' || newData.val().beginsWith('https://'))\" },\n        \"previewPath\": { \".validate\": \"newData.isString() && newData.val().length <= 500 && (newData.val() === '' || newData.val().beginsWith('tutor-courses/' + newData.parent().child('teacherId').val() + '/'))\" },\n        \"previewType\": { \".validate\": \"newData.val() === '' || newData.val() === 'image' || newData.val() === 'video'\" },\n        \"published\": { \".validate\": \"newData.isBoolean()\" },\n        \"archived\": { \".validate\": \"newData.isBoolean() && (newData.val() === false || newData.parent().child('published').val() === false)\" },\n        \"createdAt\": { \".validate\": \"newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)\" },\n        \"updatedAt\": { \".validate\": \"newData.isNumber() && newData.val() === now\" },\n        \"$other\": { \".validate\": false }\n      }\n    },\n    \"tutor_library\": {\n      \"$uid\": {\n        \".read\": \"auth != null && auth.uid === $uid\",\n        \"$kind\": {\n          \"$course\": {\n            \".write\": \"auth != null && auth.uid === $uid && ($kind === 'cart' || $kind === 'favorites') && (!newData.exists() || root.child('tutor_courses').child($course).child('published').val() === true)\",\n            \".validate\": \"newData.val() === true\"\n          }\n        }\n      }\n    },\n    \"tutor_requests\": {\n      \".indexOn\": [\"studentId\", \"teacherId\", \"courseId\"],\n      \".read\": \"auth != null && ((query.orderByChild === 'studentId' && query.equalTo === auth.uid) || (query.orderByChild === 'teacherId' && query.equalTo === auth.uid))\"