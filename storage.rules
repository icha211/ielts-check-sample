rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isDeveloper() {
      return isSignedIn() && request.auth.token.role == "developer"
        && request.auth.token.email == "quickcheck.edu@gmail.com"
        && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /speakingUploads/{uid}/{allPaths=**} {
      allow read, write: if isOwner(uid) || isDeveloper();
    }

    match /audio/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isDeveloper();
    }

    match /problemAssets/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isDeveloper();
    }

    match /profiles/{uid}/{allPaths=**} {
      allow read, delete: if isOwner(uid) || isDeveloper();
      allow create, update: if (isOwner(uid) || isDeveloper())
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|gif)');
    }

    match /community/{uid}/{postId}/attachment {
      allow read: if true;
      allow delete: if isOwner(uid) || isDeveloper();
      allow create: if isOwner(uid)
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType.matches('(image/(png|jpeg|webp)|video/(mp4|webm))');
    }
    match /community-private/{uid}/{postId}/attachment {
      // Only ciphertext is stored here. Decryption keys are in friend-protected RTDB posts.
      allow read: if true;
      allow delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.size <= 20 * 1024 * 1024 + 16
        && request.resource.contentType == 'application/octet-stream';
    }
  }
}
