{
  "rules": {
    "toefl_itp": {
      // Cloudflare audio folder URLs - saved once per setId, accessible to all users/devices
      "cloudflare_audio_folders": {
        "$setId": {
          ".read": true,
          ".write": true
        }
      },
      
      // Complete listening data - includes audio URLs, content, and metadata
      "sets_v2": {
        ".read": true,
        ".write": true,
        "$setId": {
          ".read": true,
          ".write": true
        }
      },
      
      // Draft content for editing
      "drafts_v2": {
        ".read": true,
        ".write": true,
        "$setId": {
          ".read": true,
          ".write": true
        }
      },
      
      // Legacy paths for backward compatibility
      "audio_urls": {
        "$setId": {
          "$partId": {
            ".read": true,
            ".write": true
          }
        }
      },

      "transcript_urls": {
        "$setId": {
          "$partId": {
            ".read": true,
            ".write": true
          }
        }
      },

      "sets_v1": {
        ".read": true,
        ".write": true
      },
      
      "drafts_v1": {
        "$module": {
          ".read": true,
          ".write": true
        }
      },

      "materials_library": {
        ".read": true,
        ".write": true
      },

      // Mock test / practice test scoped sets and drafts
      "mocktest": {
        ".read": true,
        ".write": true
      },

      "practicetest": {
        ".read": true,
        ".write": true
      },

      // Soft-delete/archive backups so deletes can move data instead of losing it
      "archive": {
        ".read": true,
        ".write": true
      }
    },
    ".read": false,
    ".write": false
  }
}
