{
  "rules": {
    ".read": false,
    ".write": false,

    "user_history_summaries": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true))",
        ".write": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)",
        ".indexOn": ["timestamp"]
      }
    },

    "user_submission_details": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true))",
        ".write": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)"
      }
    },

    "user_test_history": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".indexOn": ["recordedAt"]
      }
    },

    "message_contacts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$peer": {
          ".write": "auth != null && $uid !== $peer && (auth.uid === $uid || auth.uid === $peer) && ((data.exists() && !newData.exists() && !newData.parent().parent().child($peer).child($uid).exists()) || (!data.exists() && !root.child('message_contacts').child($peer).child($uid).exists() && newData.child('status').val() === (auth.uid === $uid ? 'outgoing' : 'incoming') && newData.parent().parent().child($peer).child($uid).child('status').val() === (auth.uid === $uid ? 'incoming' : 'outgoing') && root.child('partnerDirectory').child(auth.uid === $uid ? $peer : $uid).exists()) || (data.child('status').val() === (auth.uid === $uid ? 'incoming' : 'outgoing') && newData.child('status').val() === 'connected' && newData.parent().parent().child($peer).child($uid).child('status').val() === 'connected'))",
          ".validate": "newData.hasChildren(['status', 'updatedAt', 'requesterId'])",
          "status": { ".validate": "newData.isString() && (newData.val() === 'outgoing' || newData.val() === 'incoming' || newData.val() === 'connected')" },
          "updatedAt": { ".validate": "newData.isNumber() && newData.val() === now" },
          "requesterId": { ".validate": "newData.isString() && newData.val() === (newData.parent().child('status').val() === 'outgoing' ? $uid : newData.parent().child('status').val() === 'incoming' ? $peer : data.parent().child('status').val() === 'outgoing' ? $uid : $peer)" },
          "$other": { ".validate": false }
        }
      }
    },

    "notification_state": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['acceptedSeenAt'])",
        "acceptedSeenAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "$other": { ".validate": false }
      }
    },

    "user_messages": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$peer": {
          ".indexOn": ["sentAt"],
          "$message": {
            ".write": "auth != null && newData.exists() && $uid !== $peer && newData.child('senderId').val() === auth.uid && ((auth.uid === $uid && newData.child('recipientId').val() === $peer) || (auth.uid === $peer && newData.child('recipientId').val() === $uid)) && ((!data.exists() && root.child('message_contacts').child(auth.uid).child(newData.child('recipientId').val()).child('status').val() === 'connected' && !newData.child('editedAt').exists() && !newData.child('deletedAt').exists()) || (data.child('senderId').val() === auth.uid && newData.child('recipientId').val() === data.child('recipientId').val() && newData.child('sentAt').val() === data.child('sentAt').val() && !data.child('deletedAt').exists() && ((newData.child('deletedAt').val() === now && newData.child('text').val() === 'Message deleted' && newData.child('editedAt').val() === data.child('editedAt').val()) || (!newData.child('deletedAt').exists() && newData.child('editedAt').val() === now))))",
            ".validate": "newData.hasChildren(['senderId', 'recipientId', 'text', 'sentAt']) && newData.child('senderId').val() === newData.parent().parent().parent().child($peer).child($uid).child($message).child('senderId').val() && newData.child('recipientId').val() === newData.parent().parent().parent().child($peer).child($uid).child($message).child('recipientId').val() && newData.child('text').val() === newData.parent().parent().parent().child($peer).child($uid).child($message).child('text').val() && newData.child('sentAt').val() === newData.parent().parent().parent().child($peer).child($uid).child($message).child('sentAt').val() && newData.child('editedAt').val() === newData.parent().parent().parent().child($peer).child($uid).child($message).child('editedAt').val() && newData.child('deletedAt').val() === newData.parent().parent().parent().child($peer).child($uid).child($message).child('deletedAt').val()",
            "senderId": { ".validate": "newData.isString() && newData.val() === auth.uid" },
            "recipientId": { ".validate": "newData.isString()" },
            "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000" },
            "sentAt": { ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)" },
            "editedAt": { ".validate": "newData.isNumber() && (newData.val() === now || (data.exists() && newData.val() === data.val()))" },
            "deletedAt": { ".validate": "newData.isNumber() && newData.val() === now" },
            "$other": { ".validate": false }
          }
        }
      }
    },

    "message_receipts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$peer": {
          ".write": "auth != null && auth.uid === $peer && $uid !== $peer && root.child('user_messages').child($peer).child($uid).exists() && newData.exists()",
          ".validate": "newData.hasChildren(['readAt'])",
          "readAt": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now && (!data.exists() || newData.val() >= data.val())" },
          "$other": { ".validate": false }
        }
      }
    },

    "message_preferences": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$peer": {
          ".write": "auth != null && auth.uid === $uid && $uid !== $peer",
          "favorite": { ".validate": "newData.isBoolean()" },
          "archived": { ".validate": "newData.isBoolean()" },
          "deleted": { ".validate": "newData.isBoolean()" },
          "readAt": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now" },
          "$other": { ".validate": false }
        }
      }
    },

    "partnerDirectory": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['displayName', 'nationality', 'level', 'photoURL'])",
        "displayName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "nationality": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "level": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "photoURL": {
          ".validate": "newData.isString() && newData.val().length <= 2048"
        },
        "presence": {
          "$connectionId": {
            ".validate": "newData.isBoolean()"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true))",
        ".write": "auth != null && (auth.uid === $uid || (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true))"
      }
    },

    "subscriptions": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true))",
        ".write": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)"
      }
    },

    "toefl_itp": {
      "cloudflare_audio_folders": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)"
      },
      "materials_library": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)"
      },
      "sets_v2": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)"
      },
      "drafts_v2": {
        ".read": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)",
        ".write": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)"
      },
      "sets_v1": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)"
      },
      "drafts_v1": {
        ".read": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)",
        ".write": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)"
      },
      "mocktest": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)"
      },
      "practicetest": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)"
      },
      "archive": {
        ".read": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)",
        ".write": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)"
      },
      "audio_urls": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)"
      },
      "transcript_urls": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)"
      }
    }
  }
}