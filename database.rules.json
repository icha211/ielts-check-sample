{
  "rules": {
    ".read": false,
    ".write": false,

    "user_history_summaries": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true))",
        ".write": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)",
        ".indexOn": ["timestamp"]
      }
    },

    "user_submission_details": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true))",
        ".write": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)"
      }
    },

    "user_test_history": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".indexOn": ["recordedAt"]
      }
    },

    "message_contacts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$peer": {
          ".write": "auth != null && $uid !== $peer && (auth.uid === $uid || auth.uid === $peer) && ((data.exists() && !newData.exists() && !newData.parent().parent().child($peer).child($uid).exists()) || (!data.exists() && !root.child('message_contacts').child($peer).child($uid).exists() && newData.child('status').val() === (auth.uid === $uid ? 'outgoing' : 'incoming') && newData.parent().parent().child($peer).child($uid).child('status').val() === (auth.uid === $uid ? 'incoming' : 'outgoing') && root.child('partnerDirectory').child(auth.uid === $uid ? $peer : $uid).exists()) || (data.child('status').val() === (auth.uid === $uid ? 'incoming' : 'outgoing') && newData.child('status').val() === 'connected' && newData.parent().parent().child($peer).child($uid).child('status').val() === 'connected'))",
          ".validate": "newData.hasChildren(['status', 'updatedAt', 'requesterId'])",
          "status": { ".validate": "newData.isString() && (newData.val() === 'outgoing' || newData.val() === 'incoming' || newData.val() === 'connected')" },
          "updatedAt": { ".validate": "newData.isNumber() && newData.val() === now" },
          "requesterId": { ".validate": "newData.isString() && newData.val() === (newData.parent().child('status').val() === 'outgoing' ? $uid : newData.parent().child('status').val() === 'incoming' ? $peer : data.parent().child('status').val() === 'outgoing' ? $uid : $peer)" },
          "$other": { ".validate": false }
        }
      }
    },

    "community_profiles": {
      "$uid": {
        ".read": true,
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['bio', 'location', 'interests', 'shareConnections'])",
        "bio": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "location": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "interests": { ".validate": "newData.isString() && newData.val().length <= 240" },
        "shareConnections": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    },
    "community_connections": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('community_profiles').child($uid).child('shareConnections').val() === true)",
        "$peer": {
          ".write": "auth != null && $uid !== $peer && (auth.uid === $uid || auth.uid === $peer) && (!newData.exists() || (newData.val() === true && newData.parent().parent().parent().child('message_contacts').child($uid).child($peer).child('status').val() === 'connected' && newData.parent().parent().parent().child('message_contacts').child($peer).child($uid).child('status').val() === 'connected'))",
          ".validate": "newData.val() === true"
        }
      }
    },
    "notification_state": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['acceptedSeenAt'])",
        "acceptedSeenAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "$other": { ".validate": false }
      }
    },

    "user_messages": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$peer": {
          ".indexOn": ["sentAt"],
          "$message": {
            ".write": "auth != null && newData.exists() && $uid !== $peer && newData.child('senderId').val() === auth.uid && ((auth.uid === $uid && newData.child('recipientId').val() === $peer) || (auth.uid === $peer && newData.child('recipientId').val() === $uid)) && ((!data.exists() && root.child('message_contacts').child(auth.uid).child(newData.child('recipientId').val()).child('status').val() === 'connected' && !newData.child('editedAt').exists() && !newData.child('deletedAt').exists()) || (data.child('senderId').val() === auth.uid && newData.child('recipientId').val() === data.child('recipientId').val() && newData.child('sentAt').val() === data.child('sentAt').val() && !data.child('deletedAt').exists() && ((newData.child('deletedAt').val() === now && newData.child('text').val() === 'Message deleted' && newData.child('editedAt').val() === data.child('editedAt').val()) || (!newData.child('deletedAt').exists() && newData.child('editedAt').val() === now))))",
            ".validate": "newData.hasChildren(['senderId', 'recipientId', 'text', 'sentAt']) && newData.child('senderId').val() === newData.parent().parent().parent().child($peer).child($uid).child($message).child('senderId').val() && newData.child('recipientId').val() === newData.parent().parent().parent().child($peer).child($uid).child($message).child('recipientId').val() && newData.child('text').val() === newData.parent().parent().parent().child($peer).child($uid).child($message).child('text').val() && newData.child('sentAt').val() === newData.parent().parent().parent().child($peer).child($uid).child($message).child('sentAt').val() && newData.child('editedAt').val() === newData.parent().parent().parent().child($peer).child($uid).child($message).child('editedAt').val() && newData.child('deletedAt').val() === newData.parent().parent().parent().child($peer).child($uid).child($message).child('deletedAt').val()",
            "senderId": { ".validate": "newData.isString() && newData.val() === auth.uid" },
            "recipientId": { ".validate": "newData.isString()" },
            "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000" },
            "sentAt": { ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)" },
            "editedAt": { ".validate": "newData.isNumber() && (newData.val() === now || (data.exists() && newData.val() === data.val()))" },
            "deletedAt": { ".validate": "newData.isNumber() && newData.val() === now" },
            "$other": { ".validate": false }
          }
        }
      }
    },

    "message_receipts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$peer": {
          ".write": "auth != null && auth.uid === $peer && $uid !== $peer && root.child('user_messages').child($peer).child($uid).exists() && newData.exists()",
          ".validate": "newData.hasChildren(['readAt'])",
          "readAt": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now && (!data.exists() || newData.val() >= data.val())" },
          "$other": { ".validate": false }
        }
      }
    },

    "message_preferences": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$peer": {
          ".write": "auth != null && auth.uid === $uid && $uid !== $peer",
          "favorite": { ".validate": "newData.isBoolean()" },
          "archived": { ".validate": "newData.isBoolean()" },
          "deleted": { ".validate": "newData.isBoolean()" },
          "readAt": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now" },
          "$other": { ".validate": false }
        }
      }
    },

    "community_posts": {
      ".read": true,
      ".indexOn": ["createdAt"],
      "$post": {
        ".write": "auth != null && newData.exists() && ((!data.exists() && newData.child('authorId').val() === auth.uid && !newData.child('deletedAt').exists() && !newData.child('updatedAt').exists()) || (data.exists() && !data.child('deletedAt').exists() && (data.child('authorId').val() === auth.uid || (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true && newData.child('deletedAt').val() === now && newData.child('title').val() === data.child('title').val() && newData.child('body').val() === data.child('body').val() && newData.child('category').val() === data.child('category').val() && newData.child('groupId').val() === data.child('groupId').val() && newData.child('updatedAt').val() === data.child('updatedAt').val()))))",
        ".validate": "newData.hasChildren(['authorId', 'title', 'body', 'category', 'groupId', 'createdAt', 'mediaURL', 'mediaPath', 'mediaType'])",
        "authorId": { ".validate": "newData.isString() && (data.exists() ? newData.val() === data.val() : newData.val() === auth.uid)" },
        "title": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
        "body": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 4000" },
        "category": { ".validate": "newData.isString() && (newData.val() === 'questions' || newData.val() === 'tips' || newData.val() === 'buddies' || (newData.val() === 'announcements' && ((data.exists() && newData.val() === data.val()) || (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true))))" },
        "groupId": { ".validate": "newData.isString() && (newData.val() === '' || newData.val() === 'general' || newData.val() === 'speaking' || newData.val() === 'writing' || newData.val() === 'listening' || newData.val() === 'reading')" },
        "visibility": { ".validate": "newData.val() === 'public'" },
        "mediaKey": { ".validate": "newData.val() === ''" },
        "mediaIV": { ".validate": "newData.val() === ''" },
        "createdAt": { ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)" },
        "updatedAt": { ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() || newData.val() === now : newData.val() === now)" },
        "deletedAt": { ".validate": "newData.isNumber() && newData.val() === now" },
        "mediaURL": { ".validate": "newData.isString() && newData.val().length <= 2048 && (data.exists() ? newData.val() === data.val() : newData.val() === '' || newData.val().beginsWith('https://firebasestorage.googleapis.com/'))" },
        "mediaPath": { ".validate": "newData.isString() && (data.exists() ? newData.val() === data.val() : newData.val() === '' || newData.val() === 'community/' + auth.uid + '/' + $post + '/attachment')" },
        "mediaType": { ".validate": "newData.isString() && (data.exists() ? newData.val() === data.val() : (newData.val() === '' && newData.parent().child('mediaURL').val() === '' && newData.parent().child('mediaPath').val() === '') || ((newData.val() === 'image' || newData.val() === 'video') && newData.parent().child('mediaURL').val() !== '' && newData.parent().child('mediaPath').val() !== ''))" },
        "$other": { ".validate": false }
      }
    },

    "community_likes": {
      "$post": {
        ".read": true,
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && root.child('community_posts').child($post).exists() && !root.child('community_posts').child($post).child('deletedAt').exists()",
          ".validate": "newData.val() === true || (newData.isNumber() && newData.val() > 0 && (newData.val() === now || newData.val() === data.val()))"
        }
      }
    },

    "community_comments": {
      "$post": {
        ".read": true,
        ".indexOn": ["createdAt"],
        "$comment": {
          ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('authorId').val() === auth.uid && root.child('community_posts').child($post).exists() && !root.child('community_posts').child($post).child('deletedAt').exists()) || (data.exists() && !newData.exists() && (data.child('authorId').val() === auth.uid || (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true))))",
          ".validate": "newData.hasChildren(['authorId', 'body', 'createdAt'])",
          "authorId": { ".validate": "newData.isString() && newData.val() === auth.uid" },
          "body": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000" },
          "createdAt": { ".validate": "newData.isNumber() && newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    },

    "community_private_posts": {
      "$author": {
        ".read": "auth != null && (auth.uid === $author || (root.child('message_contacts').child($author).child(auth.uid).child('status').val() === 'connected' && root.child('message_contacts').child(auth.uid).child($author).child('status').val() === 'connected'))",
        ".indexOn": ["createdAt"],
        "$post": {
          ".write": "auth != null && auth.uid === $author && newData.exists() && (!data.exists() || !data.child('deletedAt').exists())",
          ".validate": "newData.hasChildren(['authorId', 'title', 'body', 'category', 'groupId', 'visibility', 'createdAt', 'mediaURL', 'mediaPath', 'mediaType', 'mediaKey', 'mediaIV', 'mediaMime']) && newData.child('visibility').val() === 'friends' && ((newData.child('mediaType').val() === '' && newData.child('mediaURL').val() === '' && newData.child('mediaPath').val() === '' && newData.child('mediaKey').val() === '' && newData.child('mediaIV').val() === '' && newData.child('mediaMime').val() === '') || (newData.child('mediaType').val() !== '' && newData.child('mediaKey').val().length === 44 && newData.child('mediaIV').val().length === 16 && newData.child('mediaPath').val() === 'community-private/' + $author + '/' + $post + '/attachment' && newData.child('mediaURL').val().beginsWith('https://firebasestorage.googleapis.com/')))",
          "authorId": { ".validate": "newData.val() === $author" },
          "title": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
          "body": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 4000" },
          "category": { ".validate": "newData.val() === 'questions' || newData.val() === 'tips' || newData.val() === 'buddies' || (newData.val() === 'announcements' && ((data.exists() && data.val() === newData.val()) || (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)))" },
          "groupId": { ".validate": "newData.isString() && (newData.val() === '' || newData.val() === 'general' || newData.val() === 'speaking' || newData.val() === 'writing' || newData.val() === 'listening' || newData.val() === 'reading')" },
          "visibility": { ".validate": "newData.val() === 'friends'" },
          "createdAt": { ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)" },
          "updatedAt": { ".validate": "data.parent().exists() && newData.isNumber() && newData.val() === now" },
          "deletedAt": { ".validate": "data.parent().exists() && newData.isNumber() && newData.val() === now" },
          "mediaURL": { ".validate": "newData.isString() && newData.val().length <= 2048 && (!data.exists() || data.val() === newData.val())" },
          "mediaPath": { ".validate": "newData.isString() && (!data.exists() || data.val() === newData.val())" },
          "mediaType": { ".validate": "(newData.val() === '' || newData.val() === 'image' || newData.val() === 'video') && (!data.exists() || data.val() === newData.val())" },
          "mediaKey": { ".validate": "newData.isString() && (!data.exists() || data.val() === newData.val())" },
          "mediaIV": { ".validate": "newData.isString() && (!data.exists() || data.val() === newData.val())" },
          "mediaMime": { ".validate": "(newData.val() === '' || newData.val() === 'image/png' || newData.val() === 'image/jpeg' || newData.val() === 'image/webp' || newData.val() === 'video/mp4' || newData.val() === 'video/webm') && (!data.exists() || data.val() === newData.val())" },
          "$other": { ".validate": false }
        }
      }
    },
    "community_private_likes": {
      "$author": {
        "$post": {
          ".read": "auth != null && (auth.uid === $author || (root.child('message_contacts').child($author).child(auth.uid).child('status').val() === 'connected' && root.child('message_contacts').child(auth.uid).child($author).child('status').val() === 'connected'))",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('community_private_posts').child($author).child($post).exists() && !root.child('community_private_posts').child($author).child($post).child('deletedAt').exists() && (auth.uid === $author || (root.child('message_contacts').child($author).child(auth.uid).child('status').val() === 'connected' && root.child('message_contacts').child(auth.uid).child($author).child('status').val() === 'connected'))",
            ".validate": "newData.val() === true || (newData.isNumber() && newData.val() > 0 && (newData.val() === now || newData.val() === data.val()))"
          }
        }
      }
    },
    "community_private_comments": {
      "$author": {
        "$post": {
          ".read": "auth != null && (auth.uid === $author || (root.child('message_contacts').child($author).child(auth.uid).child('status').val() === 'connected' && root.child('message_contacts').child(auth.uid).child($author).child('status').val() === 'connected'))",
          ".indexOn": ["createdAt"],
          "$comment": {
            ".write": "auth != null && (auth.uid === $author || (root.child('message_contacts').child($author).child(auth.uid).child('status').val() === 'connected' && root.child('message_contacts').child(auth.uid).child($author).child('status').val() === 'connected')) && ((!data.exists() && newData.child('authorId').val() === auth.uid && root.child('community_private_posts').child($author).child($post).exists() && !root.child('community_private_posts').child($author).child($post).child('deletedAt').exists()) || (data.exists() && !newData.exists() && (data.child('authorId').val() === auth.uid || auth.uid === $author)))",
            ".validate": "newData.hasChildren(['authorId', 'body', 'createdAt'])",
            "authorId": { ".validate": "newData.val() === auth.uid" },
            "body": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000" },
            "createdAt": { ".validate": "newData.val() === now" },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "community_members": {
      ".read": "auth != null",
      "$group": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && ($group === 'general' || $group === 'speaking' || $group === 'writing' || $group === 'listening' || $group === 'reading')",
          ".validate": "newData.isBoolean() && newData.val() === true"
        }
      }
    },

    "partnerDirectory": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['displayName', 'nationality', 'level', 'photoURL'])",
        "displayName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "nationality": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "level": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "photoURL": {
          ".validate": "newData.isString() && newData.val().length <= 2048"
        },
        "presence": {
          "$connectionId": {
            ".validate": "newData.isBoolean()"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true))",
        ".write": "auth != null && (auth.uid === $uid || (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true))"
      }
    },

    "subscriptions": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true))",
        ".write": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)"
      }
    },

    "toefl_itp": {
      "cloudflare_audio_folders": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)"
      },
      "materials_library": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)"
      },
      "sets_v2": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)"
      },
      "drafts_v2": {
        ".read": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)",
        ".write": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)"
      },
      "sets_v1": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)"
      },
      "drafts_v1": {
        ".read": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)",
        ".write": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)"
      },
      "mocktest": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)"
      },
      "practicetest": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)"
      },
      "archive": {
        ".read": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)",
        ".write": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)"
      },
      "audio_urls": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)"
      },
      "transcript_urls": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.role === 'developer' && auth.token.email === 'quickcheck.edu@gmail.com' && auth.token.email_verified === true)"
      }
    }
  }
}