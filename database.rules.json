{
  "rules": {
    "toefl_itp": {
      // Cloudflare audio folder URLs - saved once per setId, accessible to all users/devices
      "cloudflare_audio_folders": {
        "$setId": {
          ".read": true,
          ".write": true,
          "folderUrl": { ".validate": "isString($root.toefl_itp.cloudflare_audio_folders[$setId].folderUrl)" },
          "savedAt": { ".validate": "isString($root.toefl_itp.cloudflare_audio_folders[$setId].savedAt)" },
          "savedByMode": { ".validate": "isString($root.toefl_itp.cloudflare_audio_folders[$setId].savedByMode)" }
        }
      },
      
      // Complete listening data - includes audio URLs, content, and metadata
      "sets_v2": {
        "$setId": {
          ".read": true,
          ".write": true,
          "id": {},
          "setId": {},
          "setDate": {},
          "module": {},
          "label": {},
          "difficulty": {},
          "testType": {},
          "updatedAt": {},
          "_updatedAt": {},
          "cloudflare_folder": {},
          
          // Per-part audio and content storage
          "parts": {
            "$partId": {
              ".read": true,
              ".write": true,
              "audio_cloudflare": {},
              "audio_firebase": {},
              "answerKey": {},
              "explanation": {},
              "questions": {},
              "transcripts": {}
            }
          }
        }
      },
      
      // Draft content for editing
      "drafts_v2": {
        "$setId": {
          ".read": true,
          ".write": true,
          "parts": {
            "$partId": {
              ".read": true,
              ".write": true,
              "audio_cloudflare": {},
              "audio_firebase": {},
              "answerKey": {},
              "explanation": {},
              "questions": {},
              "transcripts": {}
            }
          }
        }
      },
      
      // Legacy paths for backward compatibility
      "audio_urls": {
        "$setId": {
          "$partId": {
            ".read": true,
            ".write": true
          }
        }
      },
      
      "sets_v1": {
        ".read": true,
        ".write": true
      },
      
      "drafts_v1": {
        "$module": {
          ".read": true,
          ".write": true
        }
      }
    },
    ".read": false,
    ".write": false
  }
}
