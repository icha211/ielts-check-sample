{
  "rules": {
    ".read": false,
    ".write": false,

    "user_history_summaries": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.role === 'developer')",
        ".write": "auth != null && auth.token.role === 'developer'",
        ".indexOn": ["timestamp"]
      }
    },

    "user_submission_details": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.role === 'developer')",
        ".write": "auth != null && auth.token.role === 'developer'"
      }
    },

    "user_test_history": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".indexOn": ["recordedAt"]
      }
    },

    "user_messages": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$peer": {
          ".indexOn": ["sentAt"],
          "$message": {
            ".write": "auth != null && !data.exists() && newData.exists() && $uid !== $peer && newData.child('senderId').val() === auth.uid && ((auth.uid === $uid && newData.child('recipientId').val() === $peer) || (auth.uid === $peer && newData.child('recipientId').val() === $uid)) && root.child('partnerDirectory').child(newData.child('recipientId').val()).exists()",
            ".validate": "newData.hasChildren(['senderId', 'recipientId', 'text', 'sentAt'])",
            "senderId": { ".validate": "newData.isString() && newData.val() === auth.uid" },
            "recipientId": { ".validate": "newData.isString()" },
            "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000" },
            "sentAt": { ".validate": "newData.isNumber() && newData.val() === now" },
            "$other": { ".validate": false }
          }
        }
      }
    },

    "message_preferences": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$peer": {
          ".write": "auth != null && auth.uid === $uid && $uid !== $peer",
          "favorite": { ".validate": "newData.isBoolean()" },
          "archived": { ".validate": "newData.isBoolean()" },
          "deleted": { ".validate": "newData.isBoolean()" },
          "readAt": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now" },
          "$other": { ".validate": false }
        }
      }
    },

    "partnerDirectory": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['displayName', 'nationality', 'level', 'photoURL'])",
        "displayName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "nationality": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "level": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "photoURL": {
          ".validate": "newData.isString() && newData.val().length <= 2048"
        },
        "presence": {
          "$connectionId": {
            ".validate": "newData.isBoolean()"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.role === 'developer')",
        ".write": "auth != null && (auth.uid === $uid || auth.token.role === 'developer')"
      }
    },

    "subscriptions": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.role === 'developer')",
        ".write": "auth != null && auth.token.role === 'developer'"
      }
    },

    "toefl_itp": {
      "cloudflare_audio_folders": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.role === 'developer'"
      },
      "materials_library": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.role === 'developer'"
      },
      "sets_v2": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.role === 'developer'"
      },
      "drafts_v2": {
        ".read": "auth != null && auth.token.role === 'developer'",
        ".write": "auth != null && auth.token.role === 'developer'"
      },
      "sets_v1": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.role === 'developer'"
      },
      "drafts_v1": {
        ".read": "auth != null && auth.token.role === 'developer'",
        ".write": "auth != null && auth.token.role === 'developer'"
      },
      "mocktest": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.role === 'developer'"
      },
      "practicetest": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.role === 'developer'"
      },
      "archive": {
        ".read": "auth != null && auth.token.role === 'developer'",
        ".write": "auth != null && auth.token.role === 'developer'"
      },
      "audio_urls": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.role === 'developer'"
      },
      "transcript_urls": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.role === 'developer'"
      }
    }
  }
}