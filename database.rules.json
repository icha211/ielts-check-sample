{
  "rules": {
    ".read": false,
    ".write": false,

    "user_history_summaries": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.role === 'developer')",
        ".write": "auth != null && auth.token.role === 'developer'",
        ".indexOn": ["timestamp"]
      }
    },

    "user_submission_details": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.role === 'developer')",
        ".write": "auth != null && auth.token.role === 'developer'"
      }
    },

    "partnerDirectory": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['displayName', 'nationality', 'level', 'photoURL'])",
        "displayName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "nationality": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "level": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "photoURL": {
          ".validate": "newData.isString() && newData.val().length <= 2048"
        },
        "presence": {
          "$connectionId": {
            ".validate": "newData.isBoolean()"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.role === 'developer')",
        ".write": "auth != null && (auth.uid === $uid || auth.token.role === 'developer')"
      }
    },

    "subscriptions": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.role === 'developer')",
        ".write": "auth != null && auth.token.role === 'developer'"
      }
    },

    "toefl_itp": {
      "cloudflare_audio_folders": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.role === 'developer'"
      },
      "materials_library": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.role === 'developer'"
      },
      "sets_v2": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.role === 'developer'"
      },
      "drafts_v2": {
        ".read": "auth != null && auth.token.role === 'developer'",
        ".write": "auth != null && auth.token.role === 'developer'"
      },
      "sets_v1": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.role === 'developer'"
      },
      "drafts_v1": {
        ".read": "auth != null && auth.token.role === 'developer'",
        ".write": "auth != null && auth.token.role === 'developer'"
      },
      "mocktest": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.role === 'developer'"
      },
      "practicetest": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.role === 'developer'"
      },
      "archive": {
        ".read": "auth != null && auth.token.role === 'developer'",
        ".write": "auth != null && auth.token.role === 'developer'"
      },
      "audio_urls": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.role === 'developer'"
      },
      "transcript_urls": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.role === 'developer'"
      }
    }
  }
}