{
  "functions": [
    {
      "source": "functions",
      "runtime": "nodejs22"
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "emulators": {
    "auth": { "port": 9452 },
    "database": { "port": 9450 },
    "functions": { "port": 9451 },
    "hub": { "port": 9453 },
    "logging": { "port": 9454 },
    "eventarc": { "port": 9455 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.*/**",
      "**/__pycache__/**",
      "**/node_modules/**",
      "functions/**",
      "apps/**",
      ".github/**"
    ],
    "headers": [
      {
        "source": "**/*.@(mp3|wav|m4a|aac|ogg|flac)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "ielts-api-gateway",
          "region": "asia-southeast1"
        }
      }
    ]
  }
}
